    "c1_t": "10 mm",
    "c2_t": "8 mm",
    "x_c1": "base_t + mgn_h",
    "x_c2": "x_c1 + c1_t + mgn_h",
    "zr1": "20 mm",
    "c1_z0": "zr1 + s1",
    "r2_rel": "15 mm",
    "c2_z0": "c1_z0 + r2_rel + s1",
    "c2_h": "60 mm",
    "blk_rel": "30 mm",
    "belt_t": "2.41 mm",
