    "corner_hole_d": "2.8 mm",
    "hub_od": "24 mm",
    "hub_h": "12 mm",
    "shaft_af": "12 mm",
    "shaft_clearance": "0.15 mm",
    "setscrew_d": "2.5 mm"
  },
