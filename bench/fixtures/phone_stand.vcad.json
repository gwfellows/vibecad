          ]
        },
        {
          "type": "distance",
          "on": [
            "lip_rect_bottom"
          ],
          "value": "lip_t",
          "name": "lip_rect_width"
        },
        {
          "type": "distance",
          "on": [
            "lip_rect_right"
          ],
          "value": "lip_h",
          "name": "lip_rect_height"
        },
        {
          "type": "distance_x",
          "on": [
            "origin",
            "lip_rect_bottom.p1"
          ],
          "value": 0.0
        },
        {
          "type": "distance_y",
          "on": [
            "origin",
            "lip_rect_bottom.p1"
          ],
          "value": "base_t"
        }
      ]
