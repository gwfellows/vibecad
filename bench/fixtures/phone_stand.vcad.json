    {
      "id": "lip_body",
      "type": "extrude",
      "intent": "Front lip catching the phone's bottom edge, flush with the base's front face.",
      "profile": {
        "sketch": "lip_sk"
      },
      "distance": "stand_width",
      "direction": "symmetric"
    },
    {
      "id": "ease_edges",
      "type": "fillet",
      "intent": "Break sharp top edges of the lip and back panel for comfort and cleaner FDM printing.",
      "edges": [
        {
          "between": [
            {
              "feature": "lip_body",
              "role": "side",
              "entity": "lip_rect_left"
            },
            {
              "feature": "lip_body",
              "role": "side",
              "entity": "lip_rect_top"
            }
          ],
          "note": "top-front edge of the lip, softened for comfort/handling"
        },
        {
          "between": [
            {
              "feature": "back_body",
              "role": "side",
              "entity": "front_face"
            },
            {
              "feature": "back_body",
              "role": "side",
              "entity": "back_top"
            }
          ],
          "note": "top edge of the leaning back panel"
        }
      ],
      "radius": "1.5"
    }
  ]
}
