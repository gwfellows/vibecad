{
  "vibecad": "0.1",
  "name": "Battery Strap",
  "material": "steel sheet 2mm",
  "process": "laser cut + bend",
  "design_notes": "Upper half of two-part battery mount. Sits on top of battery_tray.vcad.json. Flanges hang outside the tray walls; M3 bolts through strap flanges and tray walls clamp the battery. All params must match battery_tray.vcad.json.",
  "params": {
    "bat_l": "70 mm",
    "bat_w": "35 mm",
    "bat_h": "20 mm",
    "sheet_t": "2 mm",
    "clr": "1 mm",
    "wall_h": "20 mm",
    "flange_h": "15 mm",
    "bolt_d": "3.2 mm",
    "bolt_x": "17.5 mm",
    "bolt_z": "14 mm"
  },
  "features": [
    {
      "id": "tplate_sk",
      "type": "sketch",
      "intent": "top plate footprint; full width including flange area",
      "plane": {
        "datum": "XY",
        "offset": "sheet_t + wall_h"
      },
      "entities": [
        {
          "id": "tp_bot",
          "p1": [
            -37.0,
            -22.5
          ],
          "p2": [
            37.0,
            -22.5
          ],
          "type": "line"
        },
        {
          "id": "tp_right",
          "p1": [
            37.0,
            -22.5
          ],
          "p2": [
            37.0,
            22.5
          ],
          "type": "line"
        },
        {
          "id": "tp_top",
          "p1": [
            37.0,
            22.5
          ],
          "p2": [
            -37.0,
            22.5
          ],
          "type": "line"
        },
        {
          "id": "tp_left",
          "p1": [
            -37.0,
            22.5
          ],
          "p2": [
            -37.0,
            -22.5
          ],
          "type": "line"
        }
      ],
      "constraints": [
        {
          "type": "horizontal",
          "on": [
            "tp_bot"
          ]
        },
        {
          "type": "horizontal",
          "on": [
            "tp_top"
          ]
        },
        {
          "type": "vertical",
          "on": [
            "tp_right"
          ]
        },
        {
          "type": "vertical",
          "on": [
            "tp_left"
          ]
        },
        {
          "type": "coincident",
          "on": [
            "tp_bot.p2",
            "tp_right.p1"
          ]
        },
        {
          "type": "coincident",
          "on": [
            "tp_right.p2",
            "tp_top.p1"
          ]
        },
        {
          "type": "coincident",
          "on": [
            "tp_top.p2",
            "tp_left.p1"
          ]
        },
        {
          "type": "coincident",
          "on": [
            "tp_left.p2",
            "tp_bot.p1"
          ]
        },
        {
          "type": "symmetric",
          "on": [
            "tp_bot.p1",
            "tp_bot.p2",
            "y_axis"
          ]
        },
        {
          "type": "symmetric",
          "on": [
            "tp_left.p1",
            "tp_left.p2",
            "x_axis"
          ]
        },
        {
          "type": "distance",
          "on": [
            "tp_bot"
          ],
          "value": "bat_l + 2 * sheet_t",
          "name": "strap_len"
        },
        {
          "type": "distance",
          "on": [
            "tp_left"
          ],
          "value": "bat_w + 2 * clr + 4 * sheet_t",
          "name": "strap_wid"
        }
      ]
    },
    {
      "id": "tplate_extrude",
      "type": "extrude",
      "name": "Top Plate",
      "intent": "top plate presses on battery top and spans full width between flanges",
      "profile": {
        "sketch": "tplate_sk"
      },
      "distance": "sheet_t",
      "mode": "new"
    },
    {
      "id": "lflange_sk",
      "type": "sketch",
      "intent": "left flange cross-section; hangs outside tray wall, bolt holes align with tray wall holes",
      "plane": {
        "datum": "XZ",
        "offset": "bat_w / 2 + clr + 2 * sheet_t"
      },
      "entities": [
        {
          "id": "lf_bot",
          "p1": [
            -37.0,
            7.0
          ],
          "p2": [
            37.0,
            7.0
          ],
          "type": "line"
        },
        {
          "id": "lf_right",
          "p1": [
            37.0,
            7.0
          ],
          "p2": [
            37.0,
            22.0
          ],
          "type": "line"
        },
        {
          "id": "lf_top",
          "p1": [
            37.0,
            22.0
          ],
          "p2": [
            -37.0,
            22.0
          ],
          "type": "line"
        },
        {
          "id": "lf_left",
          "p1": [
            -37.0,
            22.0
          ],
          "p2": [
            -37.0,
            7.0
          ],
          "type": "line"
        }
      ],
      "constraints": [
        {
          "type": "horizontal",
          "on": [
            "lf_bot"
          ]
        },
        {
          "type": "horizontal",
          "on": [
            "lf_top"
          ]
        },
        {
          "type": "vertical",
          "on": [
            "lf_right"
          ]
        },
        {
          "type": "vertical",
          "on": [
            "lf_left"
          ]
        },
        {
          "type": "coincident",
          "on": [
            "lf_bot.p2",
            "lf_right.p1"
          ]
        },
        {
          "type": "coincident",
          "on": [
            "lf_right.p2",
            "lf_top.p1"
          ]
        },
        {
          "type": "coincident",
          "on": [
            "lf_top.p2",
            "lf_left.p1"
          ]
        },
        {
          "type": "coincident",
          "on": [
            "lf_left.p2",
            "lf_bot.p1"
          ]
        },
        {
          "type": "symmetric",
          "on": [
            "lf_bot.p1",
            "lf_bot.p2",
            "y_axis"
          ]
        },
        {
          "type": "distance",
          "on": [
            "lf_bot"
          ],
          "value": "bat_l + 2 * sheet_t",
          "name": "flange_len"
        },
        {
          "type": "distance",
          "on": [
            "lf_left"
          ],
          "value": "flange_h",
          "name": "flange_ht"
        },
        {
          "type": "distance_y",
          "on": [
            "origin",
            "lf_bot.p1"
          ],
          "value": "sheet_t + wall_h - flange_h",
          "name": "flange_base"
        }
      ]
    },
    {
      "id": "lflange_extrude",
      "type": "extrude",
      "name": "Left Flange",
      "intent": "left flange hanging outside tray wall; inner face at Y=-(bat_w/2+clr+sheet_t) mates with tray outer face",
      "profile": {
        "sketch": "lflange_sk"
      },
      "distance": "sheet_t",
      "direction": "reverse"
    },
    {
      "id": "lfholes_sk",
      "type": "sketch",
      "intent": "M3 bolt clearance holes through left flange; must match tray wall holes exactly",
      "plane": {
        "face": {
          "feature": "lflange_extrude",
          "role": "start",
          "note": "outer face of left flange at Y=-(bat_w/2+clr+2*sheet_t); bolt holes here align with tray wall holes when assembled"
        }
      },
      "entities": [
        {
          "id": "fh1",
          "center": [
            17.5,
            14.0
          ],
          "r": 1.6,
          "type": "circle"
        },
        {
          "id": "fh2",
          "center": [
            -17.5,
            14.0
          ],
          "r": 1.6,
          "type": "circle"
        }
      ],
      "constraints": [
        {
          "type": "symmetric",
          "on": [
            "fh1.center",
            "fh2.center",
            "y_axis"
          ]
        },
        {
          "type": "distance_x",
          "on": [
            "origin",
            "fh1.center"
          ],
          "value": "bolt_x",
          "name": "fhole_x"
        },
        {
          "type": "distance_y",
          "on": [
            "origin",
            "fh1.center"
          ],
          "value": "bolt_z",
          "name": "fhole_z"
        },
        {
          "type": "equal",
          "on": [
            "fh1",
            "fh2"
          ]
        },
        {
          "type": "diameter",
          "on": [
            "fh1"
          ],
          "value": "bolt_d",
          "name": "fhole_dia"
        }
      ]
    },
    {
      "id": "lfholes_cut",
      "type": "extrude",
      "name": "Left Flange Bolt Holes",
      "intent": "M3 clearance holes through left flange; aligns with tray wall holes at bolt_z when strap sits on tray",
      "profile": {
        "sketch": "lfholes_sk"
      },
      "distance": "sheet_t",
      "direction": "reverse",
      "mode": "cut"
    },
    {
      "id": "right_mirror",
      "type": "mirror",
      "name": "Right Flange (mirrored)",
      "intent": "mirror left flange and bolt holes to create matching right flange at Y=+y_flange_outer",
      "features": [
        "lflange_extrude",
        "lfholes_cut"
      ],
      "plane": {
        "datum": "XZ"
      }
    }
  ]
}
