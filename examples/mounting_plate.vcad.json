{
  "vibecad": "0.1",
  "name": "mounting_plate",
  "units": "mm",
  "material": "6061-T6 aluminum",
  "process": "CNC milled",
  "design_notes": "Adapter plate: four M4 socket-head screws in counterbores hold it down, two M3 flat-head screws in countersinks hold a sensor on top, and a blind M6 tapped hole in the middle takes a stud. Hole sizes are ISO medium-fit clearances; counterbores fit an M4 socket head (8 mm) with 0.4 mm to spare in depth.",
  "params": {
    "plate_w": 80,
    "plate_d": 60,
    "plate_t": 8,
    "screw_inset": 8,
    "m4_clear_d": 4.5,
    "m4_cbore_d": 8,
    "m4_cbore_depth": 4.4,
    "sensor_spacing": 30,
    "m3_clear_d": 3.4,
    "m3_csk_d": 6.5,
    "m6_tap_d": 5,
    "m6_depth": 6
  },
  "features": [
    {
      "id": "plate_sketch",
      "type": "sketch",
      "intent": "Plate outline, centred on the origin",
      "plane": {"datum": "XY"},
      "entities": [
        {"id": "plate_bottom", "type": "line", "p1": [-40, -30], "p2": [40, -30]},
        {"id": "plate_right", "type": "line", "p1": [40, -30], "p2": [40, 30]},
        {"id": "plate_top", "type": "line", "p1": [40, 30], "p2": [-40, 30]},
        {"id": "plate_left", "type": "line", "p1": [-40, 30], "p2": [-40, -30]}
      ],
      "constraints": [
        {"type": "coincident", "on": ["plate_bottom.p2", "plate_right.p1"]},
        {"type": "coincident", "on": ["plate_right.p2", "plate_top.p1"]},
        {"type": "coincident", "on": ["plate_top.p2", "plate_left.p1"]},
        {"type": "coincident", "on": ["plate_left.p2", "plate_bottom.p1"]},
        {"type": "horizontal", "on": ["plate_bottom"]},
        {"type": "horizontal", "on": ["plate_top"]},
        {"type": "vertical", "on": ["plate_left"]},
        {"type": "vertical", "on": ["plate_right"]},
        {"type": "symmetric", "on": ["plate_bottom.p1", "plate_top.p1", "origin"]},
        {"type": "distance", "on": ["plate_bottom"], "value": "plate_w", "name": "plate_w"},
        {"type": "distance", "on": ["plate_left"], "value": "plate_d", "name": "plate_d"}
      ]
    },
    {"id": "plate", "type": "extrude", "intent": "The plate", "profile": {"sketch": "plate_sketch"}, "distance": "plate_t"},
    {
      "id": "screw_points",
      "type": "sketch",
      "intent": "Hold-down screw positions, screw_inset from each corner",
      "plane": {"face": {"feature": "plate", "role": "end", "note": "top of the plate"}},
      "entities": [
        {"id": "s1", "type": "point", "at": [-32, -22]},
        {"id": "s2", "type": "point", "at": [32, -22]},
        {"id": "s3", "type": "point", "at": [32, 22]},
        {"id": "s4", "type": "point", "at": [-32, 22]}
      ],
      "constraints": [
        {"type": "fix", "on": ["s1"], "at": ["-plate_w / 2 + screw_inset", "-plate_d / 2 + screw_inset"]},
        {"type": "fix", "on": ["s2"], "at": ["plate_w / 2 - screw_inset", "-plate_d / 2 + screw_inset"]},
        {"type": "fix", "on": ["s3"], "at": ["plate_w / 2 - screw_inset", "plate_d / 2 - screw_inset"]},
        {"type": "fix", "on": ["s4"], "at": ["-plate_w / 2 + screw_inset", "plate_d / 2 - screw_inset"]}
      ]
    },
    {
      "id": "hold_down", "type": "hole", "intent": "M4 socket-head counterbores, through",
      "sketch": "screw_points", "kind": "counterbore", "diameter": "m4_clear_d",
      "cbore_diameter": "m4_cbore_d", "cbore_depth": "m4_cbore_depth"
    },
    {
      "id": "sensor_points",
      "type": "sketch",
      "intent": "Sensor screws on the centreline, sensor_spacing apart",
      "plane": {"face": {"feature": "plate", "role": "end", "note": "top of the plate"}},
      "entities": [
        {"id": "a", "type": "point", "at": [-15, 0]},
        {"id": "b", "type": "point", "at": [15, 0]}
      ],
      "constraints": [
        {"type": "fix", "on": ["a"], "at": ["-sensor_spacing / 2", 0]},
        {"type": "fix", "on": ["b"], "at": ["sensor_spacing / 2", 0]}
      ]
    },
    {
      "id": "sensor_screws", "type": "hole", "intent": "M3 flat-head countersinks (90 degrees), through",
      "sketch": "sensor_points", "kind": "countersink", "diameter": "m3_clear_d", "csk_diameter": "m3_csk_d"
    },
    {
      "id": "stud_point",
      "type": "sketch",
      "intent": "Stud position: the plate centre",
      "plane": {"face": {"feature": "plate", "role": "end", "note": "top of the plate"}},
      "entities": [{"id": "c", "type": "point", "at": [0, 0]}],
      "constraints": [{"type": "coincident", "on": ["c", "origin"]}]
    },
    {
      "id": "stud_hole", "type": "hole", "intent": "M6 tapped blind hole for a stud (tap drill, 118 degree point)",
      "sketch": "stud_point", "diameter": "m6_tap_d", "extent": "blind", "depth": "m6_depth", "thread": "M6x1"
    }
  ]
}
